# Copy to .env and fill in the keys you have. Both are optional --
# tools that need a missing key degrade to an actionable message instead of failing.

# Sketchfab: needed only to DOWNLOAD models (search works without it).
# Get one at https://sketchfab.com/settings/password (API Token tab).
SKETCHFAB_API_TOKEN=

# OpenRouter: powers evaluate_scene_visually (cheap-VLM scene critique)
# when the host model itself cannot see images. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the default cheap vision model used for evaluate_scene_visually.
OPENROUTER_VISION_MODEL=

# AI 3D Generative Models:
# Meshy AI (https://meshy.ai):
MESHY_API_KEY=

# Tripo3D (https://tripo3d.ai):
TRIPO_API_KEY=

# Trellis 3D / Hugging Face (https://huggingface.co):
TRELLIS_API_KEY=
HF_TOKEN=
